# Creator Inbox — environment variables
# Copy to .env for local dev (never commit the real .env).
# On Render these are set in the service's Environment tab.
# You only need the blocks for the platforms you actually connect.

# --- Server ---
PORT=3000                                  # Render sets this automatically.
BASE_URL=https://your-app.onrender.com     # Public base URL; used to build OAuth redirect URIs.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Google OAuth (shared client for Gmail + YouTube) ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Printed in the logs once after the first sign-in, then pasted here for a permanent connection:
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx   # Gmail account
CONNECTED_EMAIL=you@your-domain.com
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx  # YouTube account (can be a different Google login)
YOUTUBE_CHANNEL=Your Channel Name

# --- Instagram (own professional account; "Instagram API with Instagram Login") ---
# App ID/secret come from the Instagram product in your Meta app.
INSTAGRAM_APP_ID=0000000000000000
INSTAGRAM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Printed in the logs once after connecting (/auth/instagram), then pasted here:
INSTAGRAM_ACCESS_TOKEN=IGAAxxxxxxxxxxxxxxxxxxxx   # long-lived (~60 day, auto-refreshes on boot)
INSTAGRAM_USER_ID=1784xxxxxxxxxxxxx
INSTAGRAM_USER=yourhandle

# --- Facebook (own Page comments + Messenger) ---
# App ID/secret = your Meta app's App ID and App Secret (Facebook Login product).
FACEBOOK_APP_ID=0000000000000000
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Printed in the logs once after connecting (/auth/facebook), then pasted here:
FACEBOOK_PAGE_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx       # Page token (long-lived / non-expiring)
FACEBOOK_PAGE_ID=1000000000000000
FACEBOOK_PAGE_NAME=Your Page Name

# --- Threads (own account replies; separate Meta "Threads" use case) ---
# App ID/secret come from the Threads use case in your Meta app (NOT the Instagram ones).
THREADS_APP_ID=0000000000000000
THREADS_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Printed in the logs once after connecting (/auth/threads), then pasted here:
THREADS_ACCESS_TOKEN=THxxxxxxxxxxxxxxxxxxxx       # long-lived (~60 day, auto-refreshes on boot)
THREADS_USER_ID=1784xxxxxxxxxxxxx
THREADS_USER=yourhandle

# --- Discord (own server messages, via a bot) ---
# Create a bot in the Discord Developer Portal, turn ON the "Message Content" intent,
# add the bot to your server, then paste its token here. No OAuth sign-in needed.
DISCORD_APP_ID=0000000000000000                  # Application ID (used to build the invite link)
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_BOT_NAME=Your Bot Name

# --- Database (Supabase) — makes every connection permanent ---
# With these set, the app saves each platform's tokens + your tone sheet to the
# database itself and reloads them on every restart. No more copying tokens from
# logs. Get both from Supabase: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co       # Project URL
SUPABASE_SERVICE_KEY=eyJhbGciOi...                       # service_role key (secret; server-side only)

# --- AI drafting (optional) ---
# If unset, drafts use a simple templated fallback. If set, drafts are written in your tone.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-haiku-latest
